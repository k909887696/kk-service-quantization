<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kk.business.quantization.dao.mapper.SyDagMainMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.kk.business.quantization.dao.entity.SyDagMain">
        <id column="dag_id" property="dagId" />
        <result column="dag_name" property="dagName" />
        <result column="node_code" property="nodeCode" />
        <result column="run_params" property="runParams" />
        <result column="run_cron" property="runCron" />
        <result column="pre_run_time" property="preRunTime" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
        <result column="ex_message" property="exMessage" />
        <result column="dag_flow_info" property="dagFlowInfo" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="BaseColumnList">
        a.dag_id as 'dagId',
        a.dag_name as 'dagName',
        a.node_code as 'nodeCode',
        b.node_name as 'nodeName',
        a.run_params as 'runParams',
        a.run_cron as 'runCron',
        a.pre_run_time as 'preRunTime',
        a.status as 'status',
        a.create_time as 'createTime',
        a.ex_message as 'exMessage',
        a.dag_flow_info as 'dagFlowInfo'

    </sql>
    <!-- 通用查询条件 -->
    <sql id="BaseWhere">
        <trim prefix="where" prefixOverrides="and | or">
           <if test="syDagMainListReqVo.dagId != null and syDagMainListReqVo.dagId != ''">
               and a.dag_id = #{syDagMainListReqVo.dagId}
           </if>
           <if test="syDagMainListReqVo.dagName != null and syDagMainListReqVo.dagName != ''">
               and a.dag_name like concat('%',#{syDagMainListReqVo.dagName},'%')
           </if>
           <if test="syDagMainListReqVo.nodeCode != null and syDagMainListReqVo.nodeCode != ''">
               and a.node_code = #{syDagMainListReqVo.nodeCode}
           </if>
           <if test="syDagMainListReqVo.runParams != null and syDagMainListReqVo.runParams != ''">
               and a.run_params = #{syDagMainListReqVo.runParams}
           </if>
           <if test="syDagMainListReqVo.runCron != null and syDagMainListReqVo.runCron != ''">
               and a.run_cron = #{syDagMainListReqVo.runCron}
           </if>
           <if test="syDagMainListReqVo.preRunTimeStart != null and syDagMainListReqVo.preRunTimeStart != ''">
               and a.pre_run_time >= #{syDagMainListReqVo.preRunTimeStart}
           </if>
           <if test="syDagMainListReqVo.preRunTimeEnd != null and syDagMainListReqVo.preRunTimeEnd != ''">
               and a.pre_run_time &lt;= #{syDagMainListReqVo.preRunTimeEnd}
           </if>
           <if test="syDagMainListReqVo.status != null and syDagMainListReqVo.status != ''">
               and a.status = #{syDagMainListReqVo.status}
           </if>
           <if test="syDagMainListReqVo.createTimeStart != null and syDagMainListReqVo.createTimeStart != ''">
               and a.create_time >= #{syDagMainListReqVo.createTimeStart}
           </if>
           <if test="syDagMainListReqVo.createTimeEnd != null and syDagMainListReqVo.createTimeEnd != ''">
               and a.create_time &lt;= #{syDagMainListReqVo.createTimeEnd}
           </if>
           <if test="syDagMainListReqVo.exMessage != null and syDagMainListReqVo.exMessage != ''">
               and a.ex_message = #{syDagMainListReqVo.exMessage}
           </if>
           <if test="syDagMainListReqVo.dagFlowInfo != null and syDagMainListReqVo.dagFlowInfo != ''">
               and a.dag_flow_info = #{syDagMainListReqVo.dagFlowInfo}
           </if>
        </trim>
    </sql>

    <!-- 分页查询 -->
    <select id="selectSyDagMainPageList" resultType="com.kk.business.quantization.model.vobase.res.SyDagMainListResVo">
        select <include refid="BaseColumnList"/>
        from sy_dag_main a
        left join sy_dag_node b on a.node_code = b.node_code
        <include refid="BaseWhere"/>

    </select>



</mapper>
