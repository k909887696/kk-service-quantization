[Unit]
Description={serviceName}.service
After=network.target

[Service]
User=sysadmin
WorkingDirectory=/application/{serviceName}

# 显式指定 JDK 21 环境变量
Environment="JAVA_HOME=/application/java/jdk-21.0.11+10"
Environment="PATH=/application/java/jdk-21.0.11+10/bin:/usr/local/bin:/usr/bin:/bin"

# 核心启动命令：指定 JDK 21 绝对路径 + JVM 内存参数 + JAR 包路径
ExecStart=/application/java/jdk-21.0.11+10/bin/java -Xms1024m -Xmx2048m -jar /application/{serviceName}/{serviceName}-1.0-SNAPSHOT.jar --spring.cloud.nacos.config.server-addr={nacosServerAddr} --spring.profiles.active={activeProfile}

# 允许 Java 应用通过 SIGTERM 正常退出
SuccessExitStatus=143

# 2. 核心：自动重启策略
Restart=on-failure          # 仅在非正常退出（如崩溃、非0退出码、被信号杀死）时重启
RestartSec=5s               # 每次重启前等待 5 秒，避免 CPU 空转

# 3. 防无限重启机制（防止程序陷入死循环崩溃导致雪崩）
StartLimitIntervalSec=300   # 在 300 秒（5分钟）的窗口内
StartLimitBurst=5           # 最多允许重启 5 次，超过则放弃并标记服务为 failed

# 4. 超时与优雅停机控制
TimeoutStartSec=30s         # 启动超时，超过 30 秒未就绪则判定失败
TimeoutStopSec=60s          # 停止超时，给应用（如 Java/Go）足够的时间处理优雅关闭

# 【核心修改】：丢弃标准输出和错误输出，完全交由 Log4j2 接管
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target  # 设置为开机自启